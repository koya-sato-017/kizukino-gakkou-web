{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kizukino-gakkou-scheduler",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["17 * * * *", "47 */2 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
